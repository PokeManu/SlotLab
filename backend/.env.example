# Copiare in .env. Il file .env non deve essere caricato su Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Solo dietro un proxy sullo stesso host, con Express limitato al loopback.
# SLOTLAB_TRUST_PROXY=loopback

# Generare 32 byte casuali in esadecimale con il comando nel README.
# Non usare password personali o il valore di questo esempio.
SLOTLAB_JWT_SECRET=

# Facoltativo: percorso ASSOLUTO di un database diverso da quello operativo.
# Se omesso si usa backend/db/database.sqlite.
# SLOTLAB_DB_PATH=/percorso/assoluto/database.sqlite
# Percorso distinto usato soltanto da npm run db:seed-demo.
# SLOTLAB_DEMO_DB_PATH=/percorso/assoluto/database-demo.sqlite

# Recupero password via SMTP. Lasciare vuoto finché il provider non è configurato.
# SLOTLAB_SMTP_HOST=smtp.example.com
# SLOTLAB_SMTP_PORT=465
# SLOTLAB_SMTP_SECURE=true
# SLOTLAB_SMTP_FROM=slotlab@example.com
# SLOTLAB_SMTP_USER=
# SLOTLAB_SMTP_PASSWORD=
# SLOTLAB_SMTP_CA_FILE=/percorso/assoluto/ca.pem
