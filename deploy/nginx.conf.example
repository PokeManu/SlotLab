# Esempio da adattare: dominio, certificato e directory della build www.
# Includere nel contesto http di Nginx; il file principale deve caricare mime.types.
server {
    listen 80;
    server_name slotlab.example.org;
    return 301 https://slotlab.example.org$request_uri;
}

server {
    listen 443 ssl;
    server_name slotlab.example.org;
    ssl_certificate /etc/ssl/slotlab/fullchain.pem;
    ssl_certificate_key /etc/ssl/slotlab/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /srv/slotlab/www;
    index index.html;
    client_max_body_size 8m;

    location /api/ {
        # Nessuna slash finale: preserva /api/v1 nella richiesta a Express.
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Sovrascrive l'header del client: non fidarsi di una catena ricevuta.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_cache off;
        proxy_intercept_errors off;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
